{{- /* atom.xml - Atom 1.0 syndication feed for Dev9b */ -}}
{{- $pages := where .Site.RegularPages "Type" "in" .Site.Params.mainSections -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
    {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- $authorName := .Site.Params.meta.author | default "F9XR Team" -}}
{{- $feedURL := (printf "%satom.xml" .Site.BaseURL) -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ .Site.Title }}</title>
    <subtitle>{{ .Site.Params.description | default .Site.Title }}</subtitle>
    <link href="{{ .Site.BaseURL }}" rel="alternate" />
    <link href="{{ $feedURL }}" rel="self" type="application/atom+xml" />
    <id>{{ .Site.BaseURL }}</id>
    <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</updated>
    <generator uri="https://gohugo.io/">Hugo</generator>
    <author>
        <name>{{ $authorName }}</name>
    </author>
    {{- range $pages }}
    <entry>
        <title>{{ .Title }}</title>
        <link href="{{ .Permalink }}" rel="alternate" type="text/html" />
        <id>{{ .Permalink }}</id>
        <published>{{ .PublishDate.Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</published>
        <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</updated>
        {{- with .Params.author }}
        <author>
            <name>{{ . }}</name>
        </author>
        {{- end }}
        <summary type="html">{{ .Summary | transform.XMLEscape | safeHTML }}</summary>
        <content type="html">{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content>
        {{- range .Params.tags }}
        <category term="{{ . }}" />
        {{- end }}
    </entry>
    {{- end }}
</feed>